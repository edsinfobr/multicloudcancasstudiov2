{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with preference flags and settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "The user email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name or username of the user"
        },
        "defaultCloud": {
          "type": "string",
          "description": "Default cloud provider selected by user"
        },
        "theme": {
          "type": "string",
          "description": "User theme preference: dark or light"
        },
        "language": {
          "type": "string",
          "description": "User interface language: pt, en, or es"
        },
        "leftSidebarCollapsed": {
          "type": "boolean",
          "description": "Whether the left sidebar (toolbox/catalog) is collapsed by default"
        },
        "rightSidebarCollapsed": {
          "type": "boolean",
          "description": "Whether the right sidebar (inspector/properties) is collapsed by default"
        },
        "defaultStamp": {
          "type": "object",
          "description": "Default diagram stamp settings for author, role, company, and canvas visibility",
          "properties": {
            "author": { "type": "string" },
            "role": { "type": "string" },
            "company": { "type": "string" },
            "showOnCanvas": { "type": "boolean" }
          }
        },
        "autoSave": {
          "type": "boolean",
          "description": "Whether changes auto-sync to Firestore"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["userId", "email"]
    },
    "Architecture": {
      "title": "Architecture",
      "description": "User cloud architecture project diagram, metadata, and canvas components",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique architecture project identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "description": "Project title or system name"
        },
        "description": {
          "type": "string",
          "description": "Architecture description or notes"
        },
        "nodesCount": {
          "type": "number",
          "description": "Total number of nodes"
        },
        "containersCount": {
          "type": "number",
          "description": "Total number of containers"
        },
        "linksCount": {
          "type": "number",
          "description": "Total number of links"
        },
        "diagram": {
          "type": "object",
          "description": "Complete JSON diagram state"
        },
        "tags": {
          "type": "array",
          "description": "Architecture tags"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "userId", "name", "diagram", "createdAt", "updatedAt"]
    },
    "CloudConnectionProfile": {
      "title": "CloudConnectionProfile",
      "description": "Non-secret cloud provider account connection profile (AWS, GCP, Azure, OCI)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "provider": { "type": "string", "description": "aws, gcp, azure, or oci" },
        "region": { "type": "string" },
        "accountHint": { "type": "string", "description": "Safe masked identifier or project ID" },
        "status": { "type": "string" },
        "lastTestedAt": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "label", "provider", "region", "accountHint", "status", "createdAt", "updatedAt"]
    },
    "TerraformDeployment": {
      "title": "TerraformDeployment",
      "description": "Terraform provisioning execution summary and state outputs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "architectureId": { "type": "string" },
        "architectureTitle": { "type": "string" },
        "workspaceId": { "type": "string" },
        "connectionId": { "type": "string" },
        "provider": { "type": "string" },
        "action": { "type": "string" },
        "status": { "type": "string" },
        "summaryText": { "type": "string" },
        "planSummary": { "type": "object" },
        "outputs": { "type": "object" },
        "resourcesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "architectureId", "workspaceId", "provider", "action", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and editor preferences"
    },
    "/users/{userId}/architectures/{architectureId}": {
      "schema": "Architecture",
      "description": "Architectures saved by the user with diagram state and metadata"
    },
    "/users/{userId}/cloudConnections/{connectionId}": {
      "schema": "CloudConnectionProfile",
      "description": "Non-secret cloud account connection profiles for AWS, GCP, Azure, and OCI"
    },
    "/users/{userId}/deployments/{deploymentId}": {
      "schema": "TerraformDeployment",
      "description": "Terraform deployment runs and state output summaries"
    }
  }
}
