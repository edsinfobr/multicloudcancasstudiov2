rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('theme' in data) || (data.theme in ['dark', 'light'])) &&
             (!('language' in data) || (data.language in ['pt', 'en', 'es'])) &&
             (!('defaultCloud' in data) || (data.defaultCloud in ['aws', 'azure', 'gcp', 'oci', 'all'])) &&
             (!('autoSave' in data) || (data.autoSave is bool)) &&
             (!('leftSidebarCollapsed' in data) || (data.leftSidebarCollapsed is bool)) &&
             (!('rightSidebarCollapsed' in data) || (data.rightSidebarCollapsed is bool)) &&
             (!('defaultStamp' in data) || (
               data.defaultStamp is map &&
               (!('author' in data.defaultStamp) || (data.defaultStamp.author is string && data.defaultStamp.author.size() <= 100)) &&
               (!('role' in data.defaultStamp) || (data.defaultStamp.role is string && data.defaultStamp.role.size() <= 100)) &&
               (!('company' in data.defaultStamp) || (data.defaultStamp.company is string && data.defaultStamp.company.size() <= 100)) &&
               (!('showOnCanvas' in data.defaultStamp) || (data.defaultStamp.showOnCanvas is bool))
             ));
    }

    function isValidArchitecture(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 150 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('nodesCount' in data) || (data.nodesCount is number && data.nodesCount >= 0)) &&
             (!('containersCount' in data) || (data.containersCount is number && data.containersCount >= 0)) &&
             (!('linksCount' in data) || (data.linksCount is number && data.linksCount >= 0)) &&
             ('diagram' in data && data.diagram is map) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 30));
    }

    function isValidCloudConnection(data) {
      return data.keys().hasAll(['id', 'userId', 'label', 'provider', 'region', 'accountHint', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'label', 'provider', 'region', 'accountHint', 'status', 'lastTestedAt', 'metadata', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.label is string && data.label.size() > 0 && data.label.size() <= 100 &&
             data.provider in ['aws', 'gcp', 'azure', 'oci'] &&
             data.region is string && data.region.size() > 0 && data.region.size() <= 64 &&
             data.accountHint is string && data.accountHint.size() <= 150 &&
             data.status in ['connected', 'disconnected', 'error'] &&
             (!('lastTestedAt' in data) || (data.lastTestedAt is string && data.lastTestedAt.size() <= 64)) &&
             (!('metadata' in data) || data.metadata is map) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDeployment(data) {
      return data.keys().hasAll(['id', 'userId', 'architectureId', 'workspaceId', 'provider', 'action', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'architectureId', 'architectureTitle', 'workspaceId', 'connectionId', 'provider', 'action', 'status', 'summaryText', 'planSummary', 'outputs', 'resourcesCount', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.architectureId is string && data.architectureId.size() > 0 && data.architectureId.size() <= 128 &&
             (!('architectureTitle' in data) || (data.architectureTitle is string && data.architectureTitle.size() <= 150)) &&
             data.workspaceId is string && data.workspaceId.size() > 0 && data.workspaceId.size() <= 128 &&
             (!('connectionId' in data) || (data.connectionId is string && data.connectionId.size() <= 128)) &&
             data.provider in ['aws', 'gcp', 'azure', 'oci', 'multicloud'] &&
             data.action in ['init', 'validate', 'plan', 'apply', 'refresh', 'destroy', 'replace-target', 'destroy-target'] &&
             data.status in ['queued', 'running', 'succeeded', 'failed'] &&
             (!('summaryText' in data) || (data.summaryText is string && data.summaryText.size() <= 1000)) &&
             (!('planSummary' in data) || data.planSummary is map) &&
             (!('outputs' in data) || data.outputs is map) &&
             (!('resourcesCount' in data) || (data.resourcesCount is number && data.resourcesCount >= 0)) &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // User profile and personal preferences
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Private saved architectures subcollection
      match /architectures/{architectureId} {
        allow get: if isOwner(userId) && isValidId(architectureId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(architectureId) && isValidArchitecture(incoming());
        allow update: if isOwner(userId) && isValidId(architectureId) && isValidArchitecture(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(architectureId);
      }

      // Non-secret cloud account connection profiles
      match /cloudConnections/{connectionId} {
        allow get: if isOwner(userId) && isValidId(connectionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(connectionId) && isValidCloudConnection(incoming());
        allow update: if isOwner(userId) && isValidId(connectionId) && isValidCloudConnection(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(connectionId);
      }

      // Terraform deployment history records
      match /deployments/{deploymentId} {
        allow get: if isOwner(userId) && isValidId(deploymentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(deploymentId) && isValidDeployment(incoming());
        allow update: if isOwner(userId) && isValidId(deploymentId) && isValidDeployment(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(deploymentId);
      }
    }
  }
}
